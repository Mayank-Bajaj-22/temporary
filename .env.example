# ==========================================
# BuddhaHome Supabase Configuration Example
# ==========================================
# Copy this file to .env and fill in your Supabase project credentials.
# Get these values from: Supabase Dashboard > Project Settings > API

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Project Anon / Public API Key
# (Safe for browser client; governed strictly by PostgreSQL Row Level Security policies)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
